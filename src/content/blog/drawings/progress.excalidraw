			"isDeleted": false,
			"boundElements": [],
			"updated": 1765402258091,
			"link": null,
			"locked": false,
			"text": "- bad judgement in the initial stages of learning a skill leads to just learning and no applying\n- being able to learn how to translate that little learning that u have to leverage & credibility requires judgement\n\n- once you have leverage, sales skills become even more important\n- you have something \"good\". you just need to make people feel it important and convince them to buy your stuff\n- this is true both for product and sales companies",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- bad judgement in the initial stages of learning a skill leads to just learning and no applying\n- being able to learn how to translate that little learning that u have to leverage & credibility requires judgement\n\n- once you have leverage, sales skills become even more important\n- you have something \"good\". you just need to make people feel it important and convince them to buy your stuff\n- this is true both for product and sales companies",
			"autoResize": true,
			"lineHeight": 1.25,
			"rawText": ""
		},
