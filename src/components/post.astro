---
import { Card, CardContent } from "./ui/card";
import { getWcAndReadingTime } from "../utils/utils";
import type { PostType } from "@/types";
import TagBadges from "./tag-badges.astro";

type Props = {
	post: PostType;
};

const { post } = Astro.props;
const { readingTime } = getWcAndReadingTime(post?.body);

const pathname = Astro.url.pathname;
---

<a href={`/blog/${post.data.slug}/`}>
	<Card className="hover:shadow-lg transition-all my-4">
		<CardContent>
			<h1 class="text-xl font-bold">{post.data.title}</h1>
			<h2 class="text-md font-medium text-muted-foreground">{post.data.subtitle}</h2>
			<!-- <p class="text-sm mt-2 text-muted-foreground">Word Count: {wordCount}</p> -->
			<TagBadges post={post} pathname={pathname} />
			<p class="text-sm mt-2 text-muted-foreground">{readingTime.minutes} Minute Read</p>
		</CardContent>
		<!-- {JSON.stringify(post)} -->
	</Card>
</a>
