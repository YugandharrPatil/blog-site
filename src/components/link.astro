---
import { buttonVariants, type ButtonVariants } from "./ui/button";

import { cn } from "@/lib/utils";

interface Props extends ButtonVariants {
	href: string;
	className?: string;
}

const { href, variant, size, className } = Astro.props;
---

<a href={href} class={cn(`${buttonVariants({ variant: variant, size: size })}`, className)} data-astro-prefetch>
	<slot />
</a>
